generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String        @id @default(cuid())
  email     String        @unique
  name      String?
  createdAt DateTime      @default(now())
  /// E.164 mobile number for agent updates over Linq. Null means texting is off.
  phone     String?
  /// Set the moment the user replies STOP. Nothing is ever sent while this is true.
  smsOptOut Boolean       @default(false)
  /// Linq's id for our conversation with this user. Its absence is what tells us
  /// the next message is the first one, which may not carry a link.
  linqChatId String?
  /// Where a replacement gets shipped. A merchant will not complete a checkout
  /// without somewhere to send it. Stored whole or not at all — a half-filled
  /// address is worse than none, because it fails at the last step.
  shipName        String?
  shipStreet      String?
  shipLocality    String?
  shipRegion      String?
  shipPostalCode  String?
  shipCountry     String?
  /// Standing authorization that lets us collect our share of banked savings.
  feeMandateId      String?
  feeMandateCapUsd  Decimal?  @db.Decimal(10, 2)
  feeMandateExpires DateTime?
  items      TrackedItem[]
  sessions   Session[]
  tokens     LoginToken[]
  feeCharges FeeCharge[]

  @@index([phone])
}

/// One text per item per kind of news. The unique index is the whole point: a
/// retried cron run or a second call into executeRebuy must not tell the user
/// twice that their money was spent.
model Notification {
  id        String   @id @default(cuid())
  itemId    String?
  userId    String?
  /// e.g. "purchase_authorized". Matches the agent event that caused it.
  kind      String
  channel   String   @default("linq")
  /// "sent" only when Linq accepted it. Anything else stays "failed" and says why.
  status    String   @default("pending")
  body      String
  messageId String?
  /// Which of iMessage, RCS or SMS actually carried it, as Linq reported it.
  protocol  String?
  error     String?
  createdAt DateTime @default(now())

  @@unique([itemId, kind])
  @@index([userId])
}

/// Inbound Linq events, keyed by Linq's own event id. Delivery is at-least-once,
/// so the id is the primary key and a repeat insert is the de-duplication.
model LinqEvent {
  id        String   @id
  type      String
  fromPhone String?
  body      String?
  payload   Json?
  at        DateTime @default(now())
}

/// One billing run per user per period. Fees accrue only on savings the user has
/// actually banked, and are charged in arrears — never before the refund lands.
model FeeCharge {
  id            String   @id @default(cuid())
  userId        String
  /// e.g. "2026-08". The unique index is what makes re-running a period safe.
  period        String
  amount        Decimal  @db.Decimal(10, 2)
  savingsBase   Decimal  @db.Decimal(10, 2)
  itemIds       String[]
  status        String   @default("pending")
  transactionId String?
  failureCode   String?
  reference     String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TrackedItem {
  id              String       @id @default(cuid())
  userId          String?
  userEmail       String
  merchantId      String       @default("anker")
  retailerName    String       @default("Anker")
  retailerUrl     String       @default("https://us.anker.com")
  currency        String       @default("USD")
  orderId         String
  productName     String
  productUrl      String?
  productHandle   String?
  variantId       String?
  variantTitle    String?
  imageUrl        String?
  purchasePrice   Decimal      @db.Decimal(10, 2)
  currentPrice    Decimal      @db.Decimal(10, 2)
  rebuyPrice      Decimal?     @db.Decimal(10, 2)
  purchaseDate    DateTime
  returnDeadline  DateTime
  /** Where returnDeadline came from: "receipt" or "merchant_policy". */
  returnWindowSource String    @default("merchant_policy")
  /// What it will cost the user to send the original back — part of the buy decision.
  returnCostUsd   Decimal      @default(0) @db.Decimal(10, 2)
  status          String       @default("ingested")
  mandateId       String?
  sessionId       String?
  /** Prava's transaction id for the completed charge — evidence, not inferred. */
  chargeTransactionId String?
  chargeReference String?
  /** Deterministic idempotency counter; must not be derived from event counts. */
  rebuyAttempts   Int          @default(0)
  /** Order reference at the merchant, once the user confirms they placed it. */
  merchantOrderRef String?
  /// Real checkout the agent created at the merchant over UCP. Completion is
  /// deliberately blocked in sandbox; see lib/ucp.ts.
  ucpCheckoutId    String?
  ucpContinueUrl   String?
  lastCheckedAt   DateTime?
  mandateExpiresAt DateTime?
  failureCode     String?
  parseConfidence Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt
  user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  prices          PricePoint[]
  events          AgentEvent[]

  @@index([userId])
  @@index([status])
}

model PricePoint {
  id     String      @id @default(cuid())
  itemId String
  price  Decimal     @db.Decimal(10, 2)
  source String      @default("merchant_live")
  at     DateTime    @default(now())
  item   TrackedItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model AgentEvent {
  id     String      @id @default(cuid())
  itemId String
  type   String
  detail Json?
  at     DateTime    @default(now())
  item   TrackedItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}
