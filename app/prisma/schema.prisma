generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String        @id @default(cuid())
  email     String        @unique
  name      String?
  createdAt DateTime      @default(now())
  /// Standing authorization that lets us collect our share of banked savings.
  feeMandateId      String?
  feeMandateCapUsd  Decimal?  @db.Decimal(10, 2)
  feeMandateExpires DateTime?
  items      TrackedItem[]
  sessions   Session[]
  tokens     LoginToken[]
  feeCharges FeeCharge[]
}

/// One billing run per user per period. Fees accrue only on savings the user has
/// actually banked, and are charged in arrears — never before the refund lands.
model FeeCharge {
  id            String   @id @default(cuid())
  userId        String
  /// e.g. "2026-08". The unique index is what makes re-running a period safe.
  period        String
  amount        Decimal  @db.Decimal(10, 2)
  savingsBase   Decimal  @db.Decimal(10, 2)
  itemIds       String[]
  status        String   @default("pending")
  transactionId String?
  failureCode   String?
  reference     String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TrackedItem {
  id              String       @id @default(cuid())
  userId          String?
  userEmail       String
  merchantId      String       @default("anker")
  retailerName    String       @default("Anker")
  retailerUrl     String       @default("https://us.anker.com")
  currency        String       @default("USD")
  orderId         String
  productName     String
  productUrl      String?
  productHandle   String?
  variantId       String?
  variantTitle    String?
  imageUrl        String?
  purchasePrice   Decimal      @db.Decimal(10, 2)
  currentPrice    Decimal      @db.Decimal(10, 2)
  rebuyPrice      Decimal?     @db.Decimal(10, 2)
  purchaseDate    DateTime
  returnDeadline  DateTime
  /** Where returnDeadline came from: "receipt" or "merchant_policy". */
  returnWindowSource String    @default("merchant_policy")
  status          String       @default("ingested")
  mandateId       String?
  sessionId       String?
  /** Prava's transaction id for the completed charge — evidence, not inferred. */
  chargeTransactionId String?
  chargeReference String?
  /** Deterministic idempotency counter; must not be derived from event counts. */
  rebuyAttempts   Int          @default(0)
  /** Order reference at the merchant, once the user confirms they placed it. */
  merchantOrderRef String?
  lastCheckedAt   DateTime?
  mandateExpiresAt DateTime?
  failureCode     String?
  parseConfidence Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt
  user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  prices          PricePoint[]
  events          AgentEvent[]

  @@index([userId])
  @@index([status])
}

model PricePoint {
  id     String      @id @default(cuid())
  itemId String
  price  Decimal     @db.Decimal(10, 2)
  source String      @default("merchant_live")
  at     DateTime    @default(now())
  item   TrackedItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model AgentEvent {
  id     String      @id @default(cuid())
  itemId String
  type   String
  detail Json?
  at     DateTime    @default(now())
  item   TrackedItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}
